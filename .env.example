# Smart Workload System - Example Environment Configuration
# Copy this file to .env and replace placeholders with real values.

PORT_GATEWAY=5000
PORT_USER_SERVICE=5001
PORT_PROJECT_SERVICE=5002
PORT_TASK_SERVICE=5003
PORT_CAPACITY_SERVICE=5004
PORT_REPORT_SERVICE=5005
PORT_NOTIFICATION_SERVICE=5006

MONGO_URI=mongodb://127.0.0.1:27017/smart_workload
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# SMTP Configuration (replace with real credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Smart Workload System <noreply@example.com>

# Storage Configuration (replace with real credentials)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=your_s3_bucket
AWS_S3_REGION=your_s3_region
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SSO Configuration (replace with real credentials)
SSO_PROVIDER=local
SSO_ISSUER=https://accounts.example.com
SSO_CLIENT_ID=your_sso_client_id
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_CALLBACK_URL=http://localhost:5000/api/auth/sso/callback

# Google Calendar Integration (replace with real credentials)
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/capacity/calendar/callback

# HRMS Integration (replace with real endpoint)
HRMS_API_URL=http://localhost:9090/api/hrms
HRMS_API_KEY=your_hrms_api_key

NODE_ENV=development
